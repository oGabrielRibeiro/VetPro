# ===========================================
# VETPRO BACKEND - VARIÁVEIS DE AMBIENTE
# ===========================================

# --- Configurações do Servidor ---
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# --- Banco de Dados ---
DATABASE_URL="postgresql://user:password@localhost:5432/vetpro?schema=public"

# --- JWT ---
JWT_SECRET=sua_chave_jwt_aqui_mude_em_producao
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis (Cache - Opcional) ---
# Para ativar cache: definir REDIS_URL
# REDIS_URL=redis://localhost:6379

# --- AWS S3 (Cloud Storage - Opcional) ---
# Para ativar S3: definir AWS_ACCESS_KEY_ID
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# CLOUD_BUCKET_NAME=vetpro-uploads
# CLOUD_STORAGE_PROVIDER=s3  # opções: s3, local

# --- Google OAuth (Opcional) ---
# Para ativar OAuth: OAUTH_ENABLED=true
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/oauth/google/callback

# --- Frontend URL (para redirects OAuth) ---
# FRONTEND_URL=http://localhost:3000

# --- HTTPS (opcional) ---
# HTTPS=false
# HTTPS_KEY_PATH=
# HTTPS_CERT_PATH=
