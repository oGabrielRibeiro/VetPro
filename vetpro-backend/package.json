{
  "name": "vetpro-backend",
  "version": "1.0.0",
  "description": "Backend VetPro - Sistema de Prontuários Veterinários",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "smoke:checklist": "node src/scripts/smoke-checklist.js",
    "infra:up": "docker compose --project-directory .. -f ../docker-compose.yml up -d postgres redis",
    "infra:down": "docker compose --project-directory .. -f ../docker-compose.yml stop postgres redis",
    "infra:status": "docker compose --project-directory .. -f ../docker-compose.yml ps postgres redis",
    "verify:local": "npm run infra:up && npm run lint && npm test -- --runInBand && npm run smoke:checklist",
    "ai:evaluate": "node src/scripts/evaluate-chat-assist.js",
    "ai:evaluate:mobile": "node src/scripts/evaluate-chat-assist-mobile.js",
    "ai:evaluate:field-dataset": "node src/scripts/evaluate-field-agent-dataset.js",
    "ai:evaluate:field-dataset:simulated": "node src/scripts/evaluate-field-agent-dataset.js --simulate-asr --runs=12",
    "ai:quality:dashboard": "node src/scripts/field-assist-quality-dashboard.js",
    "ai:quality:alerts": "node src/scripts/field-assist-regression-alerts.js",
    "ai:regression:suite": "node src/scripts/field-assist-regression-suite.js",
    "ai:benchmark:ci": "node src/scripts/run-ai-benchmarks-ci.js",
    "ai:dataset:field": "node src/scripts/build-field-training-dataset.js",
    "ai:gold:build": "node src/scripts/build-field-assist-gold-dataset.js",
    "ai:gold:validate": "node src/scripts/validate-field-assist-gold-dataset.js",
    "ai:feedback:report": "node src/scripts/field-assist-feedback-report.js",
    "ai:feedback:export": "node src/scripts/field-assist-export-supervised.js",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/s3-request-presigner": "^3.1005.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "otplib": "^13.4.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-pretty": "^12.1.0",
    "prisma": "^7.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.0.3",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2"
  }
}
