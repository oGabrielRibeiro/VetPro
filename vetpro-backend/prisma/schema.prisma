datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum ExamType {
  RADIOGRAPHY
  ULTRASOUND
  LAB_RESULT
  CLINICAL_PHOTO
  DOCUMENT
  OTHER
}

model User {
  id               String  @id @default(uuid())
  name             String
  email            String  @unique
  password         String
  googleId         String? // ID do Google OAuth
  crmv             String?
  phone            String?
  specialty        String?
  profilePhoto     String?
  signature        String?
  twoFactorEnabled Boolean @default(false)
  totpSecret       String?
  tokenVersion     Int     @default(0)
  clinicId         String
  clinic           Clinic  @relation(fields: [clinicId], references: [id])

  consultations Consultation[]
  patients      Patient[]
  appointments  Appointment[]
  refreshSessions RefreshSession[]
  tempTokens      TempToken[]

  @@index([googleId])
}

model RefreshSession {
  id              String   @id @default(uuid())
  tokenHash       String   @unique
  tokenJti        String   @unique
  fingerprintHash String?
  userAgent       String?
  ipAddress       String?
  expiresAt       DateTime
  revokedAt       DateTime?
  replacedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  replacedBy RefreshSession? @relation("RefreshSessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaced RefreshSession[] @relation("RefreshSessionRotation")

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model TempToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  purpose   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([purpose, expiresAt])
  @@index([userId, purpose])
}

model Patient {
  id                  String    @id @default(uuid())
  name                String
  specie              String
  subcategory         String?
  breed               String?
  sex                 String?
  age                 Int?
  birthDate           DateTime?
  weight              Float?
  color               String?
  microchip           String?
  photoUrl            String?
  status              String    @default("ativo")
  porte               String?
  ownerName           String
  ownerPhone          String?
  ownerAltPhone       String?
  ownerEmail          String?
  ownerCpf            String?
  ownerAddress        String?
  ownerPhoneEncrypted String?
  ownerAltPhoneEncrypted String?
  ownerEmailEncrypted String?
  ownerCpfEncrypted String?
  ownerAddressEncrypted String?
  ownerNotes          String?
  emergencyFlag       Boolean   @default(false)
  responsibleVet      String?
  originClinic        String?
  anestheticRiskScore Int?
  persistentProfile   Json?
  createdAt           DateTime  @default(now())

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  consultations Consultation[]
  appointments  Appointment[]
}

model Consultation {
  id               String   @id @default(uuid())
  numeroProntuario Int
  recipeNumber     Int?
  recipeYear      Int?
  clinicId         String
  clinic           Clinic   @relation(fields: [clinicId], references: [id])
  createdAt        DateTime @default(now())

  // RELAÇÕES
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Consulta de retorno
  previousConsultationId String?
  previousConsultation   Consultation?  @relation("ConsultationReturn", fields: [previousConsultationId], references: [id])
  returns                Consultation[] @relation("ConsultationReturn")

  // IDENTIFICAÇÃO
  consultationType String? // nova | retorno | emergencia

  // PARÂMETROS VITAIS
  weight          Float?
  temperature     Float?
  heartRate       Int?
  respiratoryRate Int?

  // CONTEÚDO CLÍNICO
  chiefComplaint       String? // motivo da consulta
  anamnesis            String? // histórico relatado
  physicalExam         String? // exame físico
  diagnosis            String? // diagnóstico
  treatment            String? // tratamento
  procedures           String? // procedimentos realizados
  medications          String? // medicações prescritas
  notes                String? // observações gerais
  returnRecommendation String?
  customFormData       Json?   // dados de formularios especificos (anestesia, medicacao, etc.)

  // CONTROLE CLÍNICO
  vaccinationUpToDate Boolean?

  // ASSINATURA
  veterinarianName String?
  veterinarianCrmv String?

  files ConsultationFile[]
  consentSignatures ConsentSignature[]

  @@unique([userId, numeroProntuario])
}

model ConsentSignature {
  id                String   @id @default(uuid())
  type              String
  dataUrl           String
  capturedAt        DateTime @default(now())
  capturedByUserId  String
  capturedByName    String?
  clinicId          String
  patientId         String
  ip               String?
  userAgent         String?

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([clinicId])
  @@index([patientId])
}

model ConsultationFile {
  id            String   @id @default(uuid())
  filename      String
  originalName  String
  mimeType      String
  size          Int
  path          String
  thumbnailPath String?
  examType      ExamType @default(OTHER)
  createdAt     DateTime @default(now())

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

model Clinic {
  id        String   @id @default(uuid())
  name      String
  cnpj      String?
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  prescriptionTemplate String? @default("classic")
  createdAt DateTime @default(now())

  users         User[]
  patients      Patient[]
  consultations Consultation[]
  appointments  Appointment[]
}

model Appointment {
  id                   String   @id
  userId               String
  clinicId             String
  patientId            String
  date                 DateTime
  time                 String
  reason               String
  type                 String   @default("consulta")
  status               String   @default("agendado")
  linkedConsultationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([patientId])
}
