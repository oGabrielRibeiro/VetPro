{
  "openapi": "3.0.3",
  "info": {
    "title": "VetPro API",
    "description": "API do Sistema de Prontuários Veterinários VetPro",
    "version": "1.0.0",
    "contact": {
      "name": "VetPro Team",
      "email": "contato@vetpro.com.br"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Servidor de Desenvolvimento"
    }
  ],
  "tags": [
    { "name": "Autenticação", "description": "Endpoints de autenticação" },
    { "name": "Pacientes", "description": "Gerenciamento de pacientes" },
    { "name": "Consultas", "description": "Gerenciamento de consultas" },
    { "name": "Clínica", "description": "Dados da clínica" },
    { "name": "Dashboard", "description": "Estatísticas e dashboard" },
    { "name": "Utils", "description": "Utilitários e health check" }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["Utils"],
        "summary": "Verificar status da API",
        "responses": {
          "200": {
            "description": "API funcionando",
            "content": {
              "application/json": {
                "example": { "message": "VetPro API rodando 🚀" }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Utils"],
        "summary": "Health check da aplicação",
        "responses": {
          "200": {
            "description": "Servidor saudável",
            "content": {
              "application/json": {
                "example": {
                  "ok": true,
                  "timestamp": "2024-01-01T00:00:00.000Z"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Registrar novo usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string", "example": "Dr. João Silva" },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "joao@vetpro.com.br"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6,
                    "example": "123456"
                  },
                  "clinicName": {
                    "type": "string",
                    "example": "Clínica Veterinária Silva"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuário criado com sucesso" },
          "400": { "description": "Dados inválidos" },
          "409": { "description": "Email já cadastrado" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Fazer login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login bem-sucedido" },
          "401": { "description": "Credenciais inválidas" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Atualizar access token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token atualizado" },
          "401": { "description": "Refresh token inválido ou expirado" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["Autenticação"],
        "summary": "Obter dados do usuário logado",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Dados do usuário" },
          "401": { "description": "Não autenticado" }
        }
      }
    },
    "/api/patients": {
      "get": {
        "tags": ["Pacientes"],
        "summary": "Listar pacientes",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          },
          { "name": "search", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Lista de pacientes" }
        }
      },
      "post": {
        "tags": ["Pacientes"],
        "summary": "Criar novo paciente",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "specie", "ownerName"],
                "properties": {
                  "name": { "type": "string", "example": "Rex" },
                  "specie": { "type": "string", "example": "cao" },
                  "breed": { "type": "string", "example": "Labrador" },
                  "ownerName": { "type": "string", "example": "Maria Santos" },
                  "ownerPhone": { "type": "string", "example": "11999999999" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Paciente criado" }
        }
      }
    },
    "/api/patients/{id}": {
      "get": {
        "tags": ["Pacientes"],
        "summary": "Buscar paciente por ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Dados do paciente" },
          "404": { "description": "Paciente não encontrado" }
        }
      },
      "put": {
        "tags": ["Pacientes"],
        "summary": "Atualizar paciente",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object" }
            }
          }
        },
        "responses": {
          "200": { "description": "Paciente atualizado" }
        }
      },
      "delete": {
        "tags": ["Pacientes"],
        "summary": "Excluir paciente",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Paciente excluído" }
        }
      }
    },
    "/api/consultations": {
      "get": {
        "tags": ["Consultas"],
        "summary": "Listar consultas",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          }
        ],
        "responses": {
          "200": { "description": "Lista de consultas" }
        }
      },
      "post": {
        "tags": ["Consultas"],
        "summary": "Criar nova consulta",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["patientId"],
                "properties": {
                  "patientId": { "type": "string" },
                  "consultationType": {
                    "type": "string",
                    "enum": ["nova", "retorno"],
                    "default": "nova"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Consulta criada" }
        }
      }
    },
    "/api/consultations/{id}": {
      "get": {
        "tags": ["Consultas"],
        "summary": "Buscar consulta por ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Dados da consulta" },
          "404": { "description": "Consulta não encontrada" }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Obter estatísticas do dashboard",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Dados do dashboard" }
        }
      }
    },
    "/api/clinic": {
      "get": {
        "tags": ["Clínica"],
        "summary": "Obter dados da clínica",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Dados da clínica" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token de autenticação"
      }
    }
  }
}
