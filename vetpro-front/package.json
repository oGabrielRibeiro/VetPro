{
  "name": "vetpro",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Profissional de Prontuários Veterinários",
  "keywords": [
    "veterinary",
    "clinic",
    "medical-records",
    "pet-care"
  ],
  "author": "VetPro Team",
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.5",
    "date-fns": "^2.30.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^10.18.0",
    "react": "^18.2.0",
    "react-compare-image": "^3.5.14",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.7.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.17",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "check-node": "node scripts/check-node-version.js",
    "check:no-native-popups": "npm run check-node && node scripts/check-no-native-popups.js",
    "dev": "npm run check-node && vite --host 0.0.0.0 --port 3000",
    "start": "npm run dev",
    "build": "npm run check-node && vite build",
    "preview": "npm run check-node && vite preview --host 0.0.0.0 --port 3000",
    "test": "npm run check:no-native-popups && vitest run --environment jsdom --globals",
    "css:audit": "npm run check-node && node scripts/css-usage-audit.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
