{
  "name": "vetpro",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Profissional de Prontuários Veterinários",
  "keywords": [
    "veterinary",
    "clinic",
    "medical-records",
    "pet-care"
  ],
  "author": "VetPro Team",
  "engines": {
    "node": ">=20 <21"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.5",
    "date-fns": "^2.30.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^10.18.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-compare-image": "^3.5.14",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.7.0",
    "web-vitals": "^5.1.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.53.0",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test-runner": "^0.23.0",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.17",
    "axe-playwright": "^2.0.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsdom": "^27.0.1",
    "playwright": "^1.53.0",
    "postcss": "^8.4.33",
    "prettier": "^3.2.5",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.4.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  },
  "scripts": {
    "check-node": "node scripts/check-node-version.js",
    "check:no-native-popups": "npm run check-node && node scripts/check-no-native-popups.js",
    "dev": "npm run check-node && vite --host 0.0.0.0 --port 3000",
    "start": "npm run dev",
    "build": "npm run check-node && vite build",
    "preview": "npm run check-node && vite preview --host 0.0.0.0 --port 3000",
    "test": "npm run check:no-native-popups && vitest run --environment jsdom --globals",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:all": "npm run lint && npm run format:check",
    "css:audit": "npm run check-node && node scripts/css-usage-audit.js",
    "tokens:build": "npm run check-node && node scripts/generate-design-tokens.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "test-storybook --url http://127.0.0.1:6006",
    "lhci": "lhci autorun",
    "test:e2e": "playwright test"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
