POSTGRES_USER=vetpro
POSTGRES_PASSWORD=vetpro123
POSTGRES_DB=vetpro
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

BACKEND_PORT=5000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
PUBLIC_URL=http://localhost:5000
REDIS_URL=redis://redis:6379
MAX_CLINICAL_PHOTOS=8
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
VITE_CAPTCHA_SITE_KEY=
AUTH_MAX_ATTEMPTS=5
AUTH_ATTEMPT_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
UPLOAD_RATE_LIMIT_MAX=8
UPLOAD_RATE_LIMIT_WINDOW_MINUTES=1
GENERAL_RATE_LIMIT_MAX=100
GENERAL_RATE_LIMIT_WINDOW_MINUTES=15
CREATE_RATE_LIMIT_MAX=30
CREATE_RATE_LIMIT_WINDOW_MINUTES=1

# Segredo JWT (troque em producao)
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Opcional: deixe vazio para autodetectar o host atual no navegador.
# Defina explicitamente apenas se precisar fixar um backend remoto.
# Exemplo: http://192.168.0.10:5000/api
VITE_API_BASE_URL=
# Limite de fotos clinicas exibido na UI (deve combinar com o backend)
VITE_MAX_CLINICAL_PHOTOS=8
# Legacy fallback (mantido para compatibilidade durante migracao)
REACT_APP_API_BASE_URL=

# IA UTILIZADA PARA GERAR RELATÓRIOS E SUGESTÕES DE TRATAMENTO
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_FEWSHOT_EXAMPLES=3

# AWS S3 (Opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
CLOUD_REGION=us-east-1
CLOUD_BUCKET_NAME=vetpro-uploads
CLOUD_STORAGE_PROVIDER=local

# OAuth Google (Opcional)
OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/oauth/google/callback

# Documentacao Swagger
# Em producao, mantenha false (habilite apenas ambiente interno/dev)
ENABLE_SWAGGER_DOCS=false
