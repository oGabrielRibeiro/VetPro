.vetpro-cache/
**/.eslintcache

# Misc
*.local
*.tmp
*~

# ==========================
# Security & Backup
# ==========================

# Chaves de criptografia (geradas para criptografia de dados sensíveis)
*.key
*.secret
*.private

# Logs críticos do sistema
security/audit-logs/
security/db-dumps/

# Testes locais de vulnerabilidades
*penetration-test*
*security-scan*

# Backup de secrets (se criados temporariamente)
**/.secrets.bak
**/.env.backup

